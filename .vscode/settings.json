{
  "python.defaultInterpreterPath": "${workspaceFolder}/api-automation-framework/.venv/bin/python",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/api-automation-framework"
  ],
  "python.analysis.typeCheckingMode": "basic",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "api-automation-framework/tests",
    "--env=qa"
  ],
  "python.testing.cwd": "${workspaceFolder}/api-automation-framework"
}
