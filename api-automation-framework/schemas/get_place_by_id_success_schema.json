{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "location",
    "accuracy",
    "name",
    "phone_number",
    "address",
    "types",
    "website",
    "language"
  ],
  "properties": {
    "location": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {
          "type": "string",
          "minLength": 1
        },
        "longitude": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "accuracy": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "phone_number": {
      "type": "string",
      "minLength": 1
    },
    "address": {
      "type": "string",
      "minLength": 1
    },
    "types": {
      "type": "string",
      "minLength": 1
    },
    "website": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
